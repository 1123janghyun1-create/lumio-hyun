# ==============================================================================
# LUMIO ENVIRONMENT VARIABLES
# ==============================================================================

# 1. Supabase Configuration (https://supabase.com)
# Create a free project on Supabase and copy the Project URL and anon key:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# (Optional) Supabase Service Role Key for Admin operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Cloudinary Configuration (https://cloudinary.com)
# Create a free Cloudinary account for media/image hosting:
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# 3. Next.js / Vercel Domain Configuration
# Automatically provided by Vercel upon deployment, or set custom domain:
NEXT_PUBLIC_APP_URL=http://localhost:3000

